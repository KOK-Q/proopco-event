# ─────────────────────────────────────────────
# Backend API (server-only: no NEXT_PUBLIC_ prefix)
# ─────────────────────────────────────────────

# Backend base URL
API_BASE_URL=http://localhost:8000/api

# Return mock responses until the backend exists
API_MOCK=true

# Request timeout in ms
API_TIMEOUT_MS=10000

# ─────────────────────────────────────────────
# Free challenge request flow (phone → OTP → done)
# Endpoint paths are placeholders — update once the backend defines them.
# ─────────────────────────────────────────────

# POST { phone } → sends the OTP SMS
API_OTP_REQUEST_PATH=/auth/otp/request

# POST { phone, code } → verifies the OTP and registers the free challenge
API_OTP_VERIFY_PATH=/auth/otp/verify

# Code used to pass verification while API_MOCK=true
API_MOCK_OTP_CODE=12345

# ─────────────────────────────────────────────
# Client-side settings (exposed to the browser, inlined at build time)
# ─────────────────────────────────────────────

# Number of OTP digits (the modal shows one box per digit)
NEXT_PUBLIC_OTP_LENGTH=5

# Seconds before the user can request a new code
NEXT_PUBLIC_OTP_RESEND_SECONDS=120

# Phone number format — Iranian mobile: 11 digits starting with 09
NEXT_PUBLIC_PHONE_PATTERN=^09\d{9}$

# Where the "ورود به داشبورد" button sends the user after submitting
NEXT_PUBLIC_DASHBOARD_URL=https://proop.co/user
